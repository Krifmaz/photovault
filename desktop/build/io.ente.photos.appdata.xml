<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.ente.photos</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0</project_license>

  <!-- PHOTOVAULT: brand name, description and Encore colours. -->
  <name>Photovault</name>
  <summary>Safe home for your photos</summary>

  <developer id="io.github.ente-io.ente">
    <name>Photovault developers (based on Ente)</name>
  </developer>

  <description>
    <p>
      Photovault is an open-source, end-to-end encrypted (E2EE) photo storage app, that provides a secure way to backup your photos. Based on Ente (ente.com).
    </p>
  </description>

  <launchable type="desktop-id">ente.desktop</launchable>

  <content_rating type="oars-1.0" />

  <url type="bugtracker">https://github.com/ente/ente/issues</url>
  <url type="homepage">https://ente.com</url>
  <url type="vcs-browser">https://github.com/ente/ente</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/ente/ente/main/.github/assets/photos.png</image>
      <caption>Browse and search your encrypted photo library across desktop and mobile devices</caption>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#f6f6fb</color>
    <color type="primary" scheme_preference="dark">#161617</color>
  </branding>

  <releases>
    <release version="1.7" date="2025-01-13">
      <url type="details">https://github.com/ente/photos-desktop/releases</url>
    </release>
  </releases>
</component>

    <string name="backup_access_needed">Photovault needs access to your photos and videos to back them up.</string>
    <string name="backup_access_partial">Photovault can only see the photos you picked. Allow all photos and videos to back up whole folders.</string>
    <string name="backup_access_allow">Allow access</string>

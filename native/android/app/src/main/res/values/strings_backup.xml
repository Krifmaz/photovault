<!-- Camera backup. Kept in its own file so parallel features don't collide in strings.xml. -->
<resources>
    <string name="timeline_backup">Backup</string>

    <string name="backup_title">Backup</string>
    <string name="backup_enable">Back up this phone</string>
    <string name="backup_enable_detail">New photos and videos in the folders below are encrypted on this phone and uploaded to your server.</string>
    <string name="backup_folders">Folders</string>
    <string name="backup_folders_none">No photos or videos found on this phone.</string>
    <string name="backup_folders_no_access">Allow access to your photos to choose folders.</string>

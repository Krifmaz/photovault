<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gradle dependency verification, as in Ente's photos app
  (mobile/apps/photos/android/gradle/verification-metadata.xml).

  Every artifact is trusted except Ente's custom ONNX Runtime binaries: those
  come from a plain GitHub release (no repository metadata, see
  settings.gradle.kts), so their SHA-256 digests are pinned here. The digest is
  the one Ente's photos app pins (from the SHA256SUMS asset of the
  ort-packaging release); bump both together with enteOnnxRuntime in
  libs.versions.toml.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>false</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!io\.ente\.onnxruntime$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="io.ente.onnxruntime" name="onnxruntime-webgpu-android" version="1.31.0-r1">
         <artifact name="onnxruntime-webgpu-android-1.31.0-r1.aar">
            <sha256 value="e1a55bd0fe8f03c7c0a2ee4e1f9e90fd0630302bed79cba5cb78418450749f48"/>
         </artifact>
      </component>
   </components>
</verification-metadata>

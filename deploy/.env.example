# Copy to .env (docker compose) or paste into Portainer's stack "Environment variables".
PHOTOS_HOST=photos.example.com
# Optional second hostname for signed upload/download URLs (defaults to PHOTOS_HOST).
STORAGE_HOST=storage.photos.example.com
# PHOTOVAULT_IMAGE=photovault:local

# Generate each with: head -c 32 /dev/urandom | base64
PHOTOVAULT_JWT_SECRET=
PHOTOVAULT_ENCRYPTION_KEY=
PHOTOVAULT_HASHING_KEY=

# compose.yaml (PostgreSQL) only.
POSTGRES_PASSWORD=

# Create accounts with the admin CLI instead of open sign-ups.
PHOTOVAULT_ALLOW_SIGNUPS=false

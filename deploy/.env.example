# Copy to .env next to the compose file (docker compose reads it), or paste into
# Portainer's stack "Environment variables". Only compose.postgres.yaml needs one.

# compose.postgres.yaml only.
POSTGRES_PASSWORD=

# Only for an install that kept its keys in the environment. New installs leave
# these out: the server creates /config/keys.toml on first start.
# PHOTOVAULT_JWT_SECRET=
# PHOTOVAULT_ENCRYPTION_KEY=
# PHOTOVAULT_HASHING_KEY=
